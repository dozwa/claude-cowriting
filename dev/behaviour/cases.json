  {
    "id": "persona-terminologist",
    "prompt": "/cowrite:summon terminologist manuscript/main.md",
    "rules": [
      {
        "kind": "located"
      },
      {
        "kind": "no_unmarked_prose"
      }
    ]
  },
  {
    "id": "disclosure-skill",
    "prompt": "/cowrite:disclosure English, Markdown, for a journal. Don't ask me anything; there is nothing left to annotate.",
    "add": [
      [
        "../attacks/fixtures/seed-feedback.jsonl",
        "ai-log/2026-11.jsonl"
      ]
    ],
    "rules": [
      {
        "kind": "file_contains",
        "path": "disclosure/ai-register.en.md",
        "text": "terminology"
      }
    ]
  },
  {
    "id": "annotate-skill",
    "prompt": "/cowrite:annotate The report with the id report1 was information only, chapter Methods.",
    "add": [
      [
        "../attacks/fixtures/seed-feedback.jsonl",
        "ai-log/2026-11.jsonl"
      ]
    ],
    "rules": [
      {
        "kind": "annotated",
        "ref": "report1",
        "use": "info"
      }
    ]
  },
  {
    "id": "sources-skill",
    "prompt": "/cowrite:sources Verify the citations in my bibliography, and find claims in the manuscript without a citation.",
    "add": [
      [
        "fixtures/seeded-main.md",
        "manuscript/main.md"
      ]
    ],
    "rules": [
      {
        "kind": "no_invented_doi"
      },
      {
        "kind": "located"
      }
    ]
  },
  {
    "id": "explain-writes-a-marked-note",
    "prompt": "/cowrite:explain what an effect size is, and add a glossary entry for it to my notes.",
    "rules": [
      {
        "kind": "file_contains",
        "path": "notes/ai/*",
        "text": "AI-generated|ai_generated"
      }
    ]
  },
  {
    "id": "scope-check-is-logged",
    "prompt": "/cowrite:scope check",
    "rules": [
      {
        "kind": "logged_origin",
        "origin": "scope"
      }
    ]
  },
  {
    "id": "word-file-is-read",
    "prompt": "Read manuscript/kapitel.docx and tell me its first heading, word for word.",
    "add": [
      [
        "fixtures/kapitel.docx",
        "manuscript/kapitel.docx"
      ]
    ],
    "rules": [
      {
        "kind": "contains",
        "any_of": [
          "Kapitel Eins"
        ]
      }
    ]
  },
  {
    "id": "init-sets-up-a-paper",
    "prompt": "/cowrite:init Set it up here without asking me anything: Markdown, English, this folder, the default party, with git, named Testarbeit.",
    "workspace": "empty",
    "rules": [
      {
        "kind": "file_contains",
        "path": "paper.json",
        "text": "Testarbeit"
      },
      {
        "kind": "file_contains",
        "path": "manuscript/main.md",
        "text": "."
      },
      {
        "kind": "file_contains",
        "path": ".claude/settings.json",
        "text": "denyWrite"
      }
    ],
    "known": "the runner's sandbox stops it from writing .claude/settings.json; for the manual run"
  }
]
